{
  "name": "my-coffee-pos",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "start": "bun run ./dist/server/entry.mjs",
    "db:setup": "bun run scripts/setup-db.ts",
    "db:seed": "bun run scripts/seed-db.ts",
    "db:migrate": "bun run scripts/migrate-db.ts",
    "db:reset": "bun run scripts/setup-db.ts && bun run scripts/seed-db.ts",
    "docker:build": "docker build -t coffee-pos .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.1.0",
    "@astrojs/tailwind": "^6.0.0",
    "astro": "^5.1.0",
    "dexie": "^4.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^2.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
